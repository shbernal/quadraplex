# Inputs for scripts/smoke-install.sh. Copy to .env and fill in.
# The handle is probed on every registry and typed into the first-run recording.
QPLEX_SMOKE_HANDLE=
# Per-ecosystem accounts, when they differ from the handle. Leave blank to skip.
QPLEX_SMOKE_NPM=
QPLEX_SMOKE_PYPI=
QPLEX_SMOKE_AMO=
QPLEX_SMOKE_CWS=
QPLEX_SMOKE_RUBYGEMS=
QPLEX_SMOKE_JSR=
