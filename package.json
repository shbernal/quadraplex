{
  "name": "quadraplex",
  "version": "0.1.0",
  "description": "Portfolio monitor for the packages and repos you publish, with history and deltas.",
  "keywords": [
    "cli",
    "dashboard",
    "developer-tools",
    "github",
    "npm",
    "portfolio",
    "pypi",
    "tui"
  ],
  "homepage": "https://github.com/shbernal/quadraplex#readme",
  "bugs": {
    "url": "https://github.com/shbernal/quadraplex/issues"
  },
  "license": "MIT",
  "author": "shbernal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shbernal/quadraplex.git"
  },
  "bin": {
    "qplex": "dist/cli.js",
    "quadraplex": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run src/bin.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "knip": "knip",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prose": "charcheck README.md CONTRIBUTING.md CHANGELOG.md",
    "build": "bun run scripts/build.ts",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "charcheck": "^0.4.0",
    "ink": "^8.0.0",
    "knip": "^6.45.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "react": "^19.3.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.4"
}
