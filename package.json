{
  "name": "quadraplex",
  "version": "0.0.0",
  "description": "Portfolio monitor for the packages and repos you publish, with history and deltas.",
  "keywords": [
    "cli",
    "dashboard",
    "developer-tools",
    "github",
    "npm",
    "portfolio",
    "pypi",
    "tui"
  ],
  "license": "MIT",
  "author": "shbernal",
  "repository": {
    "type": "git",
    "url": "https://github.com/shbernal/quadraplex"
  },
  "bin": {
    "qplex": "dist/cli.js",
    "quadraplex": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run src/bin.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prose": "charcheck README.md CONTRIBUTING.md",
    "build": "bun run scripts/build.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "charcheck": "^0.2.5",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.14"
}
